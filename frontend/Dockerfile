# 1️⃣ React build
FROM node:18 AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG REACT_APP_GOOGLE_CLIENT_ID
ARG REACT_APP_RECAPTCHA_SITE_KEY
ARG REACT_APP_FINNHUB_API_KEY
ARG REACT_APP_TWELVE_DATA_API_KEY
ENV REACT_APP_GOOGLE_CLIENT_ID=$REACT_APP_GOOGLE_CLIENT_ID \
    REACT_APP_RECAPTCHA_SITE_KEY=$REACT_APP_RECAPTCHA_SITE_KEY \
    REACT_APP_FINNHUB_API_KEY=$REACT_APP_FINNHUB_API_KEY \
    REACT_APP_TWELVE_DATA_API_KEY=$REACT_APP_TWELVE_DATA_API_KEY
RUN npm run build

# 2️⃣ Nginx ile servis et
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
